<UserControl x:Class="XieBox.GarbageCleaner.BrowserCacheDetails" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:XieBox.Platform.UI;assembly=XieBox.Platform.UI" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
      <TextBlock Text="{Binding Consequence}" TextWrapping="Wrap" FontSize="12" LineHeight="20" />
      <TextBlock Text="按浏览器选择清理范围，也可以进入文件明细逐项保留。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Children}" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="16,14"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
        <ui:SelectionCheckBox Style="{StaticResource {x:Type CheckBox}}" IsChecked="{Binding SelectionState}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,3,0,0" AutomationProperties.Name="{Binding Name}" />
        <StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="{Binding Size}" FontSize="16" TextAlignment="Right" /><TextBlock Text="{Binding CountLabel}" Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Right" Margin="0,4,0,0" /><Button Content="文件明细" Tag="{Binding}" Style="{StaticResource FlatButton}" FontSize="12" Margin="0,6,0,0" Click="Files_Click" /></StackPanel>
      </Grid></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
