<UserControl x:Class="XieBox.GarbageCleaner.CleanerView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ui="clr-namespace:XieBox.Platform.UI;assembly=XieBox.Platform.UI" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility" /></UserControl.Resources>
  <Grid Margin="24,16,24,12">
    <StackPanel x:Name="WelcomePanel" VerticalAlignment="Center" HorizontalAlignment="Center" Width="500" Margin="0,0,0,32">
      
      <TextBlock x:Name="WelcomeTitle" HorizontalAlignment="Center" Text="{Binding WelcomeHeading}" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" />
      <TextBlock Text="{Binding WelcomeDescription}" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,16,0,32" LineHeight="24" />
      <Button x:Name="StartScanButton" Content="{Binding StartScanLabel}" Style="{StaticResource PrimaryButton}" Width="200" Height="58" FontSize="18" IsEnabled="{Binding IsIdle}" Click="Scan_Click" />
      <TextBlock Text="{Binding InitialStatus}" Style="{StaticResource StatusText}" FontSize="12" TextAlignment="Center" Margin="0,8,0,0" />
    </StackPanel>
    <Grid x:Name="ResultsPanel" Visibility="Hidden">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel MaxWidth="310"><TextBlock x:Name="ResultsTitle" HorizontalAlignment="Left" Text="垃圾清理" FontSize="22" FontWeight="SemiBold" /><TextBlock x:Name="HeaderDescription" Text="{Binding ScanLabel}" Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel>
            <StackPanel x:Name="ScanProgress" Grid.Column="1" Margin="32,0" VerticalAlignment="Center" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}">
        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,0,8" />
        <ProgressBar Height="4" IsIndeterminate="{Binding IsBusy}" Foreground="{DynamicResource AccentInkBrush}" Background="{DynamicResource AccentBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding ExclusionLabel}" Style="{StaticResource FlatButton}" IsEnabled="{Binding IsIdle}" Click="Exclude_Click" Margin="0,0,12,0" /><Button x:Name="RescanButton" Content="再次扫描" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding IsIdle}" Click="Scan_Click" /><Button Content="停止" Style="{StaticResource FlatButton}" Margin="10,0,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Click="Cancel_Click" /></StackPanel>
    </Grid>
    <DockPanel x:Name="SelectionToolbar" Grid.Row="1" Margin="0,10,0,8"><TextBlock DockPanel.Dock="Right" Text="{Binding DiskLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal"><Button Content="全选" Style="{StaticResource FlatButton}" Padding="0,8,18,8" IsEnabled="{Binding CanSelectResults}" Click="All_Click" /><Button Content="取消全选" Style="{StaticResource FlatButton}" IsEnabled="{Binding CanSelectResults}" Click="None_Click" /><TextBlock Text="{Binding SelectedCategoriesLabel}" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0" ToolTip="已选择的类目数量" /></StackPanel>
    </DockPanel>
    <Grid Grid.Row="2">
      <ListBox x:Name="ResultsList" ItemsSource="{Binding Categories}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" IsEnabled="{Binding IsIdle}">
        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0,0,0,10" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="18,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
          <ui:SelectionCheckBox Style="{StaticResource {x:Type CheckBox}}" IsChecked="{Binding SelectionState}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,4,0,0" AutomationProperties.Name="{Binding Name}" />
          <StackPanel Grid.Column="1" Margin="0,0,18,0"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding Recommendation}" Foreground="{DynamicResource AccentInkBrush}" FontSize="11" Margin="12,3,0,0" /></StackPanel>
            <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
            <TextBlock Text="{Binding Consequence}" FontSize="12" LineHeight="20" Margin="0,5,0,0" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="11" Margin="0,5,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding Size}" FontSize="18" FontWeight="Medium" TextAlignment="Right" /><TextBlock Text="{Binding CountLabel}" Style="{StaticResource MutedText}" FontSize="11" TextAlignment="Right" Margin="0,4,0,0" /><Button Content="查看明细" Tag="{Binding}" Style="{StaticResource FlatButton}" FontSize="12" Padding="4,8" Margin="0,8,0,0" Click="Details_Click" /></StackPanel>
        </Grid></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
    </Grid>
    <Border x:Name="ResultFooter" Grid.Row="3" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,20,0"><TextBlock Text="{Binding SelectionLabel}" FontWeight="Medium" /><TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="12" Margin="0,5,0,0" /></StackPanel>
      <Button Grid.Column="1" Content="清理选中内容" MinWidth="148" VerticalAlignment="Center" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanClean}" Click="Clean_Click" />
    </Grid></Border>
    </Grid>
  </Grid>
</UserControl>
