<UserControl x:Class="XieBox.StartupManager.StartupView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style TargetType="RadioButton">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Pill" CornerRadius="8" Padding="14,8" Background="Transparent"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Pill" Property="Background" Value="{DynamicResource SoftBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="StartupSwitch" TargetType="ToggleButton">
      <Setter Property="Width" Value="38" /><Setter Property="Height" Value="22" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton"><Border x:Name="Track" Background="{DynamicResource ToggleOffBrush}" CornerRadius="11"><Border x:Name="Knob" Background="{DynamicResource OnAccentBrush}" CornerRadius="8" Width="16" Height="16" Margin="3" HorizontalAlignment="Left" /></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentInkBrush}" /><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" /></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Background" Value="{DynamicResource DisabledBrush}" /><Setter TargetName="Knob" Property="Background" Value="{DynamicResource DisabledInkBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource InkBrush}" /><Setter TargetName="Track" Property="BorderThickness" Value="1" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </UserControl.Resources>
  <Grid Margin="24,16,24,12">
    <StackPanel x:Name="Intro" VerticalAlignment="Center" HorizontalAlignment="Center" Width="540">
      <TextBlock Text="启动项管理" FontSize="34" FontWeight="SemiBold" TextAlignment="Center" />
      <TextBlock Text="查看、启用或禁用开机启动应用。" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,14,0,30" />
      <Button Content="查看启动项" Width="200" Height="54" FontSize="18" Style="{StaticResource PrimaryButton}" Click="Refresh_Click" />
      <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" TextAlignment="Center" Margin="0,8,0,0" />
    </StackPanel>
    <Grid x:Name="Results" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="启动项管理" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="管理应用是否随电脑登录自动启动" Style="{StaticResource MutedText}" Margin="0,4,0,0" /></StackPanel>
        <ProgressBar Grid.Column="1" Margin="36,0" Height="4" VerticalAlignment="Center" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="系统启动设置" Style="{StaticResource FlatButton}" Click="Settings_Click" Margin="0,0,12,0" /><Button Content="刷新列表" Style="{StaticResource PrimaryButton}" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" /></StackPanel>
      </Grid>
      <Grid Grid.Row="1" Margin="0,24,0,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <RadioButton Content="全部" GroupName="Filter" IsChecked="True" Tag="0" Checked="Filter_Checked" Margin="0,0,24,0" />
          <RadioButton Content="已启用" GroupName="Filter" Tag="1" Checked="Filter_Checked" Margin="0,0,24,0" />
          <RadioButton Content="已禁用" GroupName="Filter" Tag="2" Checked="Filter_Checked" />
        </StackPanel><TextBlock Grid.Column="1" Text="{Binding Count}" Style="{StaticResource MutedText}" />
      </Grid>
      <DataGrid Grid.Row="2" ItemsSource="{Binding Entries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="66" SelectionMode="Single">
        <DataGrid.Columns>
          <DataGridTemplateColumn Header="应用" Width="*" MinWidth="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding Icon}" Width="32" Height="32" Margin="14,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" /><TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
          <DataGridTextColumn Header="发布者" Binding="{Binding Publisher}" Width="180" ElementStyle="{StaticResource TableText}" />
          <DataGridTextColumn Header="启动位置" Binding="{Binding Location}" Width="180" ElementStyle="{StaticResource TableText}" />
          <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="85" ElementStyle="{StaticResource TableText}" />
          <DataGridTemplateColumn Header="操作" Width="150"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsEnabled="{Binding DataContext.IsIdle, RelativeSource={RelativeSource AncestorType=UserControl}}"><ToggleButton Tag="{Binding}" IsChecked="{Binding Enabled, Mode=OneWay}" Click="Toggle_Click" IsEnabled="{Binding CanChange}" ToolTip="{Binding Note}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Name, StringFormat=切换 {0} 的自动启动}" Style="{StaticResource StartupSwitch}" Margin="12,0,16,0" /><Button Content="详情" Tag="{Binding}" Click="Details_Click" Style="{StaticResource FlatButton}" Padding="8,8" FontSize="12" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
      <TextBlock Grid.Row="3" Text="{Binding Status}" Style="{StaticResource StatusText}" Margin="0,8,0,0" FontSize="12" />
    </Grid>
  </Grid>
</UserControl>
