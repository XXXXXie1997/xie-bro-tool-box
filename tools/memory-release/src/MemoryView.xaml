<UserControl x:Class="XieBox.MemoryRelease.MemoryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />
    <Style x:Key="MemoryMeter" TargetType="ProgressBar"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid x:Name="PART_Track"><Border Background="{TemplateBinding Background}" CornerRadius="3" /><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" /></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </UserControl.Resources>
  <Grid Margin="24,16,24,12" x:Name="Panel">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,8,20,0" /></StackPanel>
      <Button Grid.Column="1" Content="{Binding ButtonLabel}" Click="Release_Click" IsEnabled="{Binding CanRelease}" Style="{StaticResource PrimaryButton}" MinWidth="126" VerticalAlignment="Center" />
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource SoftBrush}" Padding="22,16" CornerRadius="12" Margin="0,22,0,0">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="当前已使用" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding Snapshot.UsedText}" FontSize="22" FontWeight="SemiBold" Margin="0,4,0,0" /></StackPanel>
        <StackPanel Grid.Column="1" Margin="32,0" VerticalAlignment="Center">
          <TextBlock Text="{Binding Snapshot.UsedPercent, StringFormat=使用率 {0:0}%}" FontSize="13" Margin="0,0,0,10" />
          <ProgressBar Value="{Binding Snapshot.UsedPercent, Mode=OneWay}" Style="{StaticResource MemoryMeter}" Maximum="100" Height="6" Foreground="{DynamicResource AccentInkBrush}" Background="{DynamicResource AccentBrush}" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Snapshot.AvailableText, StringFormat=可用 {0}}" FontSize="14" /><TextBlock Text="{Binding Snapshot.TotalText, StringFormat=总内存 {0}}" Style="{StaticResource MutedText}" Margin="0,6,0,0" /></StackPanel>
      </Grid>
    </Border>
    <StackPanel Grid.Row="2" Margin="0,18,0,12">
      <TextBlock Text="{Binding ApplicationsStatus}" Style="{StaticResource StatusText}" />
      <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" Foreground="{DynamicResource AccentInkBrush}" Background="{DynamicResource AccentBrush}" />
    </StackPanel>
    <DataGrid Grid.Row="3" ItemsSource="{Binding Applications}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" RowHeight="54" SelectionMode="Single">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="应用" Width="*" MinWidth="240">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <DockPanel VerticalAlignment="Center" ToolTip="{Binding Path}">
              <Image Source="{Binding Icon}" Width="30" Height="30" Margin="14,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </DockPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="进程数" Binding="{Binding ProcessCount}" Width="120" ElementStyle="{StaticResource TableText}" />
        <DataGridTextColumn Header="内存占用" Binding="{Binding MemoryText}" Width="160" ElementStyle="{StaticResource TableText}" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" Margin="0,14,0,0">
      <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}" FontSize="12" />
      <TextBlock Text="每 3 秒更新。同一应用合并显示；部分内存由多个应用共用，列表合计可能与系统统计不同。" Style="{StaticResource MutedText}" FontSize="12" />
      <TextBlock Text="释放不会结束应用；再次访问时可能短暂变慢，Windows 会按需重新使用内存。" Style="{StaticResource MutedText}" FontSize="12" />
    </StackPanel>
  </Grid>
</UserControl>