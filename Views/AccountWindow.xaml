<ui:DialogWindow x:Class="XieBox.Views.AccountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:XieBox.Platform.UI;assembly=XieBox.Platform.UI" Title="" AutomationProperties.Name="蟹小箱账号" Width="440" Height="390" ResizeMode="NoResize" WindowStyle="None" WindowStartupLocation="CenterOwner" Closed="Window_Closed">
  <Grid Margin="24">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Image Source="{DynamicResource AppLogo}" Width="64" Height="64" Margin="0,0,20,0" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="蟹小箱 Logo" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="ModeTitle" Text="登录 / 注册" FontSize="28" FontWeight="Light" />
          <TextBlock Text="蟹小箱 · XieBroToolBox" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,8,0,0" />
        </StackPanel>
      </Grid>
      <StackPanel x:Name="SignedInPanel" Visibility="Collapsed">
        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
          <StackPanel>
            <TextBlock Text="账号邮箱" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,0,0,7" />
            <TextBlock x:Name="CurrentUsername" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
            <Border Background="{DynamicResource SoftBrush}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left" Margin="0,10,0,0">
              <TextBlock x:Name="PublicUid" FontFamily="Consolas" FontSize="12" Foreground="{DynamicResource AccentInkBrush}" />
            </Border>
          </StackPanel>
        </Border>
        <Grid Margin="2,20,2,20">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <StackPanel Margin="0,0,12,0">
            <TextBlock Text="自动登录" FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="SessionHint" Style="{StaticResource MutedText}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
          <ToggleButton x:Name="AccountAutoLogin" Grid.Column="1" Style="{StaticResource ThemeSwitch}" VerticalAlignment="Top" Margin="0,2,0,0" AutomationProperties.Name="在这台电脑上自动登录" Click="AutoLogin_Click" />
        </Grid>
        <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,16" />
        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Button x:Name="ChangePassword" Content="修改密码" Click="ChangePassword_Click" Height="38" />
          <Button x:Name="SignOut" Grid.Column="2" Content="退出登录" Click="SignOut_Click" Height="38" />
        </Grid>
      </StackPanel>
      <StackPanel x:Name="FormPanel">
        <TextBlock x:Name="IdentityLabel" Text="邮箱或已有账号" Margin="0,0,0,8" /><TextBox x:Name="Username" MaxLength="254" AutomationProperties.Name="邮箱或已有账号" TextChanged="IdentityChanged" />
        <StackPanel Margin="0,14,0,0"><TextBlock x:Name="PasswordLabel" Text="密码 · 至少 6 位" Margin="0,0,0,8" /><PasswordBox x:Name="Password" MaxLength="128" AutomationProperties.Name="密码" PasswordChanged="PasswordChanged" />
        </StackPanel>
        <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,14,0,0">
          <TextBlock Text="邮箱验证码" Margin="0,0,0,8" />
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBox x:Name="Code" MaxLength="6" AutomationProperties.Name="邮箱验证码" />
            <Button x:Name="SendCode" Grid.Column="1" Content="发送验证码" Click="SendCode_Click" Margin="12,0,0,0" Padding="12,6" />
          </Grid>
          <TextBlock Text="验证码在 5 分钟内有效" Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" />
        </StackPanel>
        <CheckBox x:Name="LoginAutoLogin" Content="在这台电脑上自动登录" Margin="0,14,0,0" />
        <Button x:Name="Submit" Content="继续" IsDefault="True" Style="{StaticResource PrimaryButton}" Click="Submit_Click" Margin="0,18,0,0" />
        <Grid Margin="0,10,0,0">
          <Button x:Name="SwitchMode" Content="返回" Visibility="Collapsed" Style="{StaticResource FlatButton}" Click="SwitchMode_Click" HorizontalAlignment="Left" FontSize="12" Padding="0,8" />
          <Button x:Name="ForgotPassword" Content="找回密码" Style="{StaticResource FlatButton}" Click="ForgotPassword_Click" HorizontalAlignment="Right" FontSize="12" Padding="0,8" />
        </Grid>
      </StackPanel>
      <TextBlock x:Name="Feedback" Margin="0,16,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel></ScrollViewer>
  </Grid>
</ui:DialogWindow>
