<Window x:Class="XieBox.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:XieBox.Platform.UI;assembly=XieBox.Platform.UI" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Title="蟹小箱" Width="1180" Height="820" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="TabContentButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="104" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource CanvasBrush}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="56" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <Border Background="{DynamicResource TitleBarBrush}"><Grid Margin="24,0,12,0"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="{DynamicResource AppLogo}" Width="30" Height="30" Margin="0,0,10,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="蟹小箱 Logo" />
          <TextBlock Text="蟹小箱" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
          
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
          <Grid Width="20" Height="20" Margin="0,0,8,0" ToolTip="浅色模式" AutomationProperties.Name="浅色模式">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Opacity" Value="1" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ThemeButton}" Value="True"><Setter Property="Opacity" Value="0.5" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Ellipse Width="8" Height="8" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" />
            <Path Data="M10,1 L10,3 M10,17 L10,19 M1,10 L3,10 M17,10 L19,10 M3.6,3.6 L5,5 M15,15 L16.4,16.4 M3.6,16.4 L5,15 M15,5 L16.4,3.6" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Grid>
          <ToggleButton x:Name="ThemeButton" Click="Theme_Click" Style="{StaticResource ThemeSwitch}" AutomationProperties.Name="深色模式" />
          <Grid Width="20" Height="20" Margin="8,0,0,0" ToolTip="深色模式" AutomationProperties.Name="深色模式">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Opacity" Value="0.5" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=ThemeButton}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger></Style.Triggers></Style></Grid.Style>
            <Path Data="M12,2 A8,8 0 1 0 18,13 A7,7 0 0 1 12,2 Z" Stroke="{DynamicResource InkBrush}" StrokeThickness="1.5" StrokeLineJoin="Round" />
          </Grid>
        </StackPanel><Button Visibility="{Binding ShowAccount, Converter={StaticResource BoolVisibility}}" Content="{Binding AccountLabel}" Click="Account_Click" Style="{StaticResource FlatButton}" MaxWidth="240" /><Button Content="关于" Click="About_Click" Style="{StaticResource FlatButton}" FontSize="13" Padding="12,7" VerticalAlignment="Center" ToolTip="版本信息与联系我们" /><Button Content="支持作者" Click="Support_Click" Style="{StaticResource FlatButton}" FontSize="13" Padding="12,7" VerticalAlignment="Center" /><Border Visibility="{Binding ShowAccount, Converter={StaticResource BoolVisibility}}" Width="1" Background="{DynamicResource LineBrush}" Margin="12,8" /><Button Click="Minimize_Click" Style="{StaticResource FlatButton}" Width="40" Height="32" Padding="0" AutomationProperties.Name="最小化"><Grid Width="10" Height="10"><Path Data="M1,5.5 L9,5.5" Stroke="{DynamicResource InkBrush}" StrokeThickness="1" SnapsToDevicePixels="True" /></Grid></Button><Button Content="□" Click="Maximize_Click" Style="{StaticResource FlatButton}" AutomationProperties.Name="最大化或还原" /><Button Content="×" Click="Close_Click" Style="{StaticResource FlatButton}" AutomationProperties.Name="退出" ToolTip="退出" /></StackPanel>
      </Grid></Border>
      <Border Grid.Row="1" Background="{DynamicResource NavigationBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,9"><DockPanel>
        <Button DockPanel.Dock="Left" Content="首页" Style="{StaticResource FlatButton}" Click="Home_Click" Margin="0,0,18,0" />
        <Button DockPanel.Dock="Right" Content="管理应用" Style="{StaticResource FlatButton}" Click="Manage_Click" />
        <Grid x:Name="NavigationStrip" SizeChanged="NavigationStrip_SizeChanged"><ScrollViewer x:Name="NavigationScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" CanContentScroll="False"><ItemsControl x:Name="NavigationItems" VerticalAlignment="Center" PreviewMouseMove="Tabs_MouseMove" PreviewMouseLeftButtonUp="Tabs_MouseUp" LostMouseCapture="Tabs_LostCapture" PreviewKeyDown="Tabs_KeyDown">
  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
  <ItemsControl.ItemTemplate><DataTemplate>
    <Border Width="{Binding NavigationTabWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="36" Margin="0,0,6,0" ToolTip="{Binding Module.Name}" ToolTipService.InitialShowDelay="350" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Tag="{Binding}" PreviewMouseLeftButtonDown="Tab_MouseDown" shell:WindowChrome.IsHitTestVisibleInChrome="True">
      <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SoftBrush}" /></Trigger><DataTrigger Binding="{Binding Module.IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /></DataTrigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /></Trigger></Style.Triggers></Style></Border.Style>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
        <Button Content="{Binding Module.Name}" Tag="{Binding}" Click="Tab_Click" Padding="10,0,2,0" ToolTip="{Binding Module.Name}" Style="{StaticResource TabContentButton}" HorizontalContentAlignment="Stretch">
          <Button.ContentTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions><ui:ModuleIcon ModuleId="{Binding Tag.Module.Id, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></Grid></DataTemplate></Button.ContentTemplate>
        </Button>
        <Button x:Name="CloseTabButton" Grid.Column="1" Tag="{Binding}" Click="TabClose_Click" IsEnabled="{Binding CanClose}" ToolTip="{Binding CloseHint}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="{Binding Module.Name, StringFormat=关闭 {0}}" Padding="0" Width="24" Height="26" Margin="0,0,4,0">
          <Button.Style><Style TargetType="Button" BasedOn="{StaticResource TabContentButton}"><Setter Property="Content" Value="×" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SoftBrush}" /></Trigger><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Content" Value="···" /></DataTrigger></Style.Triggers></Style></Button.Style>
        </Button>
        <Border Grid.ColumnSpan="2" Height="2" CornerRadius="1" Margin="12,0,12,0" VerticalAlignment="Bottom" Background="{DynamicResource AccentInkBrush}" IsHitTestVisible="False">
          <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Module.IsSelected}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
        </Border>
        <ProgressBar Grid.ColumnSpan="2" Height="2" Margin="10,0,10,1" VerticalAlignment="Bottom" IsIndeterminate="{Binding IsBusy}" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource AccentInkBrush}" Background="Transparent" IsHitTestVisible="False" />
      </Grid>
    </Border>
  </DataTemplate></ItemsControl.ItemTemplate>
</ItemsControl></ScrollViewer></Grid>
      </DockPanel></Border>
      <ContentControl Grid.Row="2" x:Name="PageHost" />
    </Grid>
  </Border>
</Window>















