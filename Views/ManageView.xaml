<UserControl x:Class="XieBox.Views.ManageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:XieBox.Platform.UI;assembly=XieBox.Platform.UI">
  <Grid>
  <ScrollViewer x:Name="ManagementScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="48,34,48,28">
    <StackPanel><TextBlock Text="管理应用" FontSize="24" FontWeight="SemiBold" /><TextBlock Text="设置应用是否在首页显示，拖动左侧手柄调整顺序。" Style="{StaticResource MutedText}" Margin="0,10,0,22" /></StackPanel>
    <Grid AllowDrop="True" PreviewDragOver="List_DragOver" PreviewDrop="List_Drop" DragLeave="List_DragLeave" Background="Transparent">
      <ItemsControl x:Name="ApplicationList" IsEnabled="{Binding IsIdle}"><ItemsControl.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Card}" Padding="10,10,16,10" Margin="0,0,0,8"><Grid MinHeight="34"><Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="0" /><ColumnDefinition Width="40" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Border Width="28" Height="32" CornerRadius="6" Cursor="SizeNS" Focusable="True" FocusVisualStyle="{x:Null}" Tag="{Binding}" ToolTip="拖动调整顺序，也可按 Alt + ↑ / ↓" AutomationProperties.Name="{Binding Name, StringFormat=拖动排序：{0}}" PreviewMouseLeftButtonDown="Handle_MouseDown" PreviewMouseLeftButtonUp="Handle_MouseUp" PreviewMouseMove="Handle_MouseMove" PreviewKeyDown="Handle_KeyDown">
            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent" /><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SoftBrush}" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentInkBrush}" /><Setter Property="BorderThickness" Value="1" /></Trigger></Style.Triggers></Style></Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Border Width="14" Height="1.5" CornerRadius="1" Background="{DynamicResource MutedBrush}" /><Border Width="14" Height="1.5" CornerRadius="1" Background="{DynamicResource MutedBrush}" Margin="0,3,0,3" /><Border Width="14" Height="1.5" CornerRadius="1" Background="{DynamicResource MutedBrush}" /></StackPanel>
          </Border>
          <ui:ModuleIcon Grid.Column="2" ModuleId="{Binding Id}" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Center" />
          <Grid Grid.Column="3" VerticalAlignment="Center" Margin="0,0,16,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Medium" /><TextBlock Grid.Column="1" Text="{Binding StateLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Availability}" Style="{StaticResource MutedText}" FontSize="12" Margin="18,0,0,0" VerticalAlignment="Center" /></Grid>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="首页显示" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="0,0,10,0" /><ToggleButton IsChecked="{Binding IsVisible, Mode=TwoWay}" Style="{StaticResource ThemeSwitch}" AutomationProperties.Name="{Binding Name, StringFormat=首页显示：{0}}" ToolTip="在首页显示此应用" Margin="0,0,20,0" /><Button Content="打开" Click="Open_Click" Tag="{Binding}" Padding="14,6" FontSize="13" /></StackPanel>
        </Grid></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Canvas x:Name="DropLayer" IsHitTestVisible="False"><Border x:Name="InsertionLine" Height="2" CornerRadius="1" Background="{DynamicResource AccentInkBrush}" Visibility="Collapsed" /></Canvas>
    </Grid>
  </StackPanel></ScrollViewer>
    <Canvas x:Name="PreviewLayer" IsHitTestVisible="False" />
  </Grid>
</UserControl>


