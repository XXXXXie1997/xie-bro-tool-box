<UserControl x:Class="XieBox.Views.AboutView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="28">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,28" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Image Source="{DynamicResource AppLogo}" Width="96" Height="96" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="蟹小箱 Logo" />
          <StackPanel Grid.Column="1" Margin="24,0,12,0" VerticalAlignment="Center">
            <TextBlock Text="蟹小箱" FontSize="36" FontWeight="Light" Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text="Windows 系统与文件管理工具箱" FontSize="13" Foreground="{DynamicResource MutedBrush}" Margin="0,12,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,4,0,0">
            <Border Background="{DynamicResource SoftBrush}" CornerRadius="12" Padding="10,4" HorizontalAlignment="Right"><TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource AccentInkBrush}" /></Border>
          </StackPanel>
        </Grid>
        <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,20,0,0">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="© 2026 xie-bro" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Content="清除应用数据" Click="Cleanup_Click" Padding="10,8" FontSize="13" Margin="0,0,10,0" />
              <Button Content="联系我们" Click="Contact_Click" Padding="14,8" FontSize="13" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
  </Grid>
</UserControl>


