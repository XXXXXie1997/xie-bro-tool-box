<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:XieBox.Platform.UI;assembly=XieBox.Platform.UI" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework">
  <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Motion.xaml" /></ResourceDictionary.MergedDictionaries>
  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
  </Style>  <ControlTemplate x:Key="VerticalScrollThumb" TargetType="Thumb">
    <Grid Background="Transparent">
      <Border x:Name="Slider" Width="4" Margin="2" CornerRadius="4" Background="{DynamicResource AccentInkBrush}" Opacity="0.38" />
    </Grid>
    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
        <Setter TargetName="Slider" Property="Width" Value="8" />
        <Setter TargetName="Slider" Property="Opacity" Value="0.68" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True" />
          <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Slider" Storyboard.TargetProperty="Width" To="8" Duration="{StaticResource Motion.FeedbackDuration}" />
          <DoubleAnimation Storyboard.TargetName="Slider" Storyboard.TargetProperty="Opacity" To="0.68" Duration="{StaticResource Motion.FeedbackDuration}" />
        </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
        <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Slider" Storyboard.TargetProperty="Width" To="4" Duration="{StaticResource Motion.FeedbackDuration}" FillBehavior="Stop" />
          <DoubleAnimation Storyboard.TargetName="Slider" Storyboard.TargetProperty="Opacity" To="0.38" Duration="{StaticResource Motion.FeedbackDuration}" FillBehavior="Stop" />
        </Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
      </MultiDataTrigger>
      <Trigger Property="IsDragging" Value="True"><Setter TargetName="Slider" Property="Background" Value="{DynamicResource InkBrush}" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  <ControlTemplate x:Key="HorizontalScrollThumb" TargetType="Thumb">
    <Grid Background="Transparent">
      <Border x:Name="Slider" Height="4" Margin="2" CornerRadius="4" Background="{DynamicResource AccentInkBrush}" Opacity="0.38" />
    </Grid>
    <ControlTemplate.Triggers>
      <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
        <Setter TargetName="Slider" Property="Height" Value="8" />
        <Setter TargetName="Slider" Property="Opacity" Value="0.68" />
      </DataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True" />
          <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
        </MultiDataTrigger.Conditions>
        <MultiDataTrigger.EnterActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Slider" Storyboard.TargetProperty="Height" To="8" Duration="{StaticResource Motion.FeedbackDuration}" />
          <DoubleAnimation Storyboard.TargetName="Slider" Storyboard.TargetProperty="Opacity" To="0.68" Duration="{StaticResource Motion.FeedbackDuration}" />
        </Storyboard></BeginStoryboard></MultiDataTrigger.EnterActions>
        <MultiDataTrigger.ExitActions><BeginStoryboard><Storyboard>
          <DoubleAnimation Storyboard.TargetName="Slider" Storyboard.TargetProperty="Height" To="4" Duration="{StaticResource Motion.FeedbackDuration}" FillBehavior="Stop" />
          <DoubleAnimation Storyboard.TargetName="Slider" Storyboard.TargetProperty="Opacity" To="0.38" Duration="{StaticResource Motion.FeedbackDuration}" FillBehavior="Stop" />
        </Storyboard></BeginStoryboard></MultiDataTrigger.ExitActions>
      </MultiDataTrigger>
      <Trigger Property="IsDragging" Value="True"><Setter TargetName="Slider" Property="Background" Value="{DynamicResource InkBrush}" /></Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>  <Style TargetType="ScrollBar">
    <Style.Resources>
      <!-- Track reserves half these metrics for its minimum thumb length. -->
      <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">24</sys:Double>
      <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">24</sys:Double>
    </Style.Resources>
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="ui:StableScrollGutter.IsEnabled" Value="True" /><Setter Property="Width" Value="16" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
      <Grid Background="{TemplateBinding Background}">
        <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb x:Name="Handle" Template="{StaticResource VerticalScrollThumb}" Focusable="False" /></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="After" Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
        </Track>
      </Grid>
      <ControlTemplate.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
          <Setter TargetName="Handle" Property="Template" Value="{StaticResource HorizontalScrollThumb}" />

          <Setter TargetName="Before" Property="Command" Value="ScrollBar.PageLeftCommand" />
          <Setter TargetName="After" Property="Command" Value="ScrollBar.PageRightCommand" />
        </Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Handle" Property="Visibility" Value="Hidden" /></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value></Setter>
    <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto" /><Setter Property="Height" Value="16" /></Trigger></Style.Triggers>
  </Style>
</ResourceDictionary>